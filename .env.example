PORT=3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=52428800
ALLOWED_ORIGINS=http://localhost:5173
# Optional. Without DATABASE_URL, upload metadata is held in memory for local development.
DATABASE_URL=
# Optional direct (unpooled) Neon connection for schema migrations.
DATABASE_URL_UNPOOLED=
# Optional S3-compatible storage. Set STORAGE_BACKEND=s3 and all S3_* variables to enable.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-2
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional. When set, clients must send Authorization: Bearer <API_KEY>.
API_KEY=
